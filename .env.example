# ShetkariSetu — Environment Configuration Template
# SIH 2026 Prototype — Govt. of Maharashtra Track

# =========================================================
# 1. Backend & Database Configuration
# =========================================================
PORT=5000
NODE_ENV=development

# MongoDB Atlas URI (Supports 2dsphere Geospatial Indexes)
# Leave blank or unconfigured to automatically use the high-performance built-in in-memory fallback store
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shetkarisetu?retryWrites=true&w=majority

# =========================================================
# 2. Python FastAPI ML Inference Microservice
# =========================================================
ML_SERVICE_URL=http://127.0.0.1:8000

# =========================================================
# 3. Bhashini Speech-To-Text API (Govt. of India)
# =========================================================
# If empty, ShetkariSetu runs high-fidelity simulated ASR for Marathi and Hindi
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_USER_ID=

# =========================================================
# 4. Firebase Authentication & Push Notifications (FCM)
# =========================================================
FIREBASE_PROJECT_ID=shetkarisetu-sih2026
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@shetkarisetu-sih2026.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# =========================================================
# 5. Frontend Public Variables (Next.js 14)
# =========================================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_MAP_ENABLED=false
